<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="edu.uic.cs478.s2026.project4">

    <!-- Custom dangerous permission unique to this app -->
    <permission
        android:name="edu.uic.cs478.s2026.project4.permission.GAME_PLAYER_2024_UNIQUE"
        android:label="@string/permission_label"
        android:description="@string/permission_description"
        android:protectionLevel="dangerous" />

    <uses-permission android:name="edu.uic.cs478.s2026.project4.permission.GAME_PLAYER_2024_UNIQUE" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.GopherHunt">

        <activity
            android:name=".MainActivity"
            android:screenOrientation="portrait"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".GameActivity"
            android:screenOrientation="portrait"
            android:exported="false" />

    </application>
</manifest>
